<Window x:Class="ADB_Tool_Automation_Post_FB.UI.DeviceDiagnosticWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IKAutomation - Farm Control"
        Width="1180" Height="820"
        MinWidth="1000" MinHeight="700"
        Background="#FFF4F7FB"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF172033"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF64748B"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#FFE2E8F0"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#FF2563EB"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#FFCBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFF8FAFC"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFE2E8F0"/>
                                <Setter Property="Foreground" Value="#FF94A3B8"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Foreground" Value="#FF334155"/>
            <Setter Property="Background" Value="#FFF1F5F9"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style x:Key="ContinuousButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#FF0F766E"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="RetryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#FFD97706"/>
        </Style>

        <Style x:Key="StopButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#FFDC2626"/>
            <Setter Property="MinHeight" Value="44"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DeviceCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="5"
                                    BorderThickness="1.5" BorderBrush="#FFCBD5E1"
                                    Background="White" Margin="0,0,8,0">
                                <Path x:Name="Mark" Data="M 3,9 L 7,13 L 15,4"
                                      Stroke="White" StrokeThickness="2" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#FF0F766E"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FF0F766E"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FF0D9488"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeviceStatusBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFF1F5F9"/>
            <Setter Property="BorderBrush" Value="#FFE2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Background" Value="#FFFFF7ED"/>
                    <Setter Property="BorderBrush" Value="#FFFED7AA"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInGame}" Value="True">
                    <Setter Property="Background" Value="#FFECFDF5"/>
                    <Setter Property="BorderBrush" Value="#FFA7F3D0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeviceRunningBadgeStyle" TargetType="Border" BasedOn="{StaticResource DeviceStatusBadgeStyle}">
            <Setter Property="Background" Value="#FFFFF7ED"/>
            <Setter Property="BorderBrush" Value="#FFFED7AA"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeviceGameBadgeStyle" TargetType="Border" BasedOn="{StaticResource DeviceStatusBadgeStyle}">
            <Setter Property="Background" Value="#FFECFDF5"/>
            <Setter Property="BorderBrush" Value="#FFA7F3D0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInGame}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeviceOfflineBadgeStyle" TargetType="Border" BasedOn="{StaticResource DeviceStatusBadgeStyle}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Điều khiển farm Infinity Kingdom"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Quản lý thiết bị, farm liên tục và theo dõi sức khỏe trong một màn hình."
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#FFDBEAFE" CornerRadius="14"
                    Padding="12,6" VerticalAlignment="Center">
                <TextBlock Text="Tối đa 25 thiết bị" Foreground="#FF1D4ED8"
                           FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}"
                    VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Thiết bị" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Chọn tối đa 25 LDPlayer cho phiên chạy."
                                       Style="{StaticResource CaptionStyle}" Margin="0,3,0,0"/>
                            <TextBlock x:Name="DeviceSummaryTextBlock"
                                       Text="Tổng: 0 · Đang mở: 0 · Trong game: 0"
                                       Style="{StaticResource CaptionStyle}" Margin="0,4,0,0"
                                       Foreground="#FF1D4ED8" Visibility="Collapsed"/>
                            <StackPanel x:Name="DeviceLoadingPanel" Orientation="Horizontal"
                                        Margin="0,5,0,0">
                                <ProgressBar Width="72" Height="5" IsIndeterminate="True"
                                             Foreground="#FF0F766E"/>
                                <TextBlock Text=" Đang tải danh sách thiết bị..."
                                           Style="{StaticResource CaptionStyle}" Margin="7,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Làm mới"
                                Click="RefreshDevices_Click"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>

                    <ListBox x:Name="DeviceSelectionListBox" Grid.Row="1"
                             MinHeight="260"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFF8FAFC" BorderBrush="#FFE2E8F0"
                                        BorderThickness="1" CornerRadius="6"
                                        Padding="10,9" Margin="0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="190"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                  IsEnabled="{Binding IsInGame}"
                                                  Content="{Binding DeviceName}"
                                                  Style="{StaticResource DeviceCheckBoxStyle}"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Border Style="{StaticResource DeviceRunningBadgeStyle}" Margin="0,0,5,0">
                                                <TextBlock Text="Đang mở" Foreground="#FF9A3412"/>
                                            </Border>
                                            <Border Style="{StaticResource DeviceGameBadgeStyle}" Margin="0,0,5,0">
                                                <TextBlock Text="Trong game" Foreground="#FF047857"/>
                                            </Border>
                                            <Border Style="{StaticResource DeviceOfflineBadgeStyle}">
                                                <TextBlock Text="Đã tắt" Foreground="#FF64748B"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button Content="Chọn tất cả" Click="SelectAllDevices_Click"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="Bỏ chọn" Click="ClearDeviceSelection_Click"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </WrapPanel>

                    <StackPanel x:Name="OneShotFarmResourcesGroupBox" Grid.Row="4">
                        <Border Height="1" Background="{StaticResource BorderBrush}"
                                Margin="0,0,0,14"/>
                        <TextBlock Text="Cấu hình farm" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="Chọn ít nhất hai loại tài nguyên để hệ thống luân phiên."
                                   Style="{StaticResource CaptionStyle}" Margin="0,3,0,12"/>
                        <WrapPanel Margin="0,0,0,6">
                            <CheckBox x:Name="IronResourceCheckBox" Content="Sắt" Margin="0,0,18,8"/>
                            <CheckBox x:Name="StoneResourceCheckBox" Content="Mỏ đá" Margin="0,0,18,8"/>
                            <CheckBox x:Name="WoodResourceCheckBox" Content="Rừng" Margin="0,0,18,8"/>
                            <CheckBox x:Name="FoodResourceCheckBox" Content="Đất nông nghiệp" Margin="0,0,0,8"/>
                        </WrapPanel>
                        <TextBlock Text="Cấp tài nguyên, đội khả dụng và lịch chờ được tự động xác định theo từng thiết bị."
                                   Style="{StaticResource CaptionStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Button x:Name="RunContinuousFarmButton" Content="▶  Chạy liên tục"
                                Click="RunContinuousFarm_Click"
                                Style="{StaticResource ContinuousButtonStyle}"/>
                        <Button x:Name="StopOneShotFarmButton" Grid.Column="2" Content="Dừng"
                                Click="StopOneShotFarm_Click"
                                Style="{StaticResource StopButtonStyle}"
                                IsEnabled="False"/>
                        <Button x:Name="RetryFailedDevicesButton"
                                Grid.Row="2" Grid.ColumnSpan="3"
                                Content="Chạy lại thiết bị lỗi"
                                Click="RetryFailedDevices_Click"
                                Style="{StaticResource RetryButtonStyle}"
                                IsEnabled="False"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardStyle}">
                    <Expander IsExpanded="True">
                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Sức khỏe hệ thống" Style="{StaticResource CardTitleStyle}"/>
                                <Border Grid.Column="1" Background="#FFEFF6FF" CornerRadius="10"
                                        Padding="9,4" Margin="16,0,0,0">
                                    <TextBlock x:Name="HealthOverviewTextBlock" Text="Chưa chạy"
                                               Foreground="#FF1D4ED8" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Expander.Header>
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Thiết bị" Style="{StaticResource CaptionStyle}"/>
                                    <TextBlock x:Name="HealthStatesTextBlock" Text="Chưa bắt đầu"
                                               Style="{StaticResource ValueStyle}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Tác vụ" Style="{StaticResource CaptionStyle}"/>
                                    <TextBlock x:Name="HealthLoadTextBlock" Text="-"
                                               Style="{StaticResource ValueStyle}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Cảnh báo · thời gian" Style="{StaticResource CaptionStyle}"/>
                                    <TextBlock Style="{StaticResource ValueStyle}" Margin="0,2,0,0">
                                        <Run x:Name="HealthPressureTextBlock" Text="Không có"/>
                                        <Run Text=" · "/>
                                        <Run x:Name="HealthUptimeTextBlock" Text="00:00:00"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="2" Background="#FFEFF6FF" CornerRadius="6" Padding="9,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Telegram" Style="{StaticResource CaptionStyle}" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="HealthHeartbeatTextBlock" Grid.Column="1" Text="Chưa gửi"
                                               Style="{StaticResource ValueStyle}" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Expander>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Expander IsExpanded="True">
                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tiến trình farm" Style="{StaticResource CardTitleStyle}"/>
                                <Border Grid.Column="1" Background="#FFEFF6FF" CornerRadius="10"
                                        Padding="9,4" Margin="16,0,0,0">
                                    <TextBlock x:Name="ProgressOverviewTextBlock" Text="Chưa chạy"
                                               Foreground="#FF1D4ED8" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Expander.Header>
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="FarmProgressItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander IsExpanded="True" Margin="0,0,0,8">
                                            <Expander.Header>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding StageDisplay}"
                                                               Foreground="#FF1D4ED8" Margin="18,0,0,0"/>
                                                </Grid>
                                            </Expander.Header>
                                            <Border Background="#FFF8FAFC" BorderBrush="#FFE2E8F0"
                                                    BorderThickness="1" CornerRadius="7"
                                                    Padding="9" Margin="12,5,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Detail}" Margin="0,5,0,0"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding TerritoryColor}" Margin="0,5,0,0"
                                                               Foreground="#FF047857" FontWeight="SemiBold"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding TeamsSummary}" Margin="0,5,0,0"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Schedule}" Margin="0,5,0,0"
                                                               Foreground="#FF1D4ED8"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                    </Expander>
                </Border>

                <TextBlock x:Name="StatusTextBlock" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
