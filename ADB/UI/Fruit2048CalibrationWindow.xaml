<Window x:Class="IK_Auto_ADB.UI.Fruit2048CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hiệu chỉnh nhận diện Fruit2048" Width="720" Height="700"
        WindowStartupLocation="CenterOwner" Background="#FFF4F7FB">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Hiệu chỉnh nhận diện" FontSize="20" FontWeight="Bold"/>
            <TextBlock x:Name="InstructionText" Margin="0,5,0,0" Foreground="#FF475569"
                       Text="Đang chụp bàn chơi..."/>
        </StackPanel>
        <Border Grid.Row="1" Background="#FF0F172A" Margin="0,14" Padding="8" CornerRadius="8">
            <Viewbox Stretch="Uniform">
                <Grid x:Name="BoardPreview" MouseLeftButtonDown="BoardPreview_MouseLeftButtonDown">
                    <Image x:Name="BoardImage" Stretch="Fill"/>
                    <UniformGrid Rows="4" Columns="4" IsHitTestVisible="False">
                        <Border x:Name="Cell00" BorderBrush="#667FFFFFFF" BorderThickness="1"/><Border x:Name="Cell01" BorderBrush="#667FFFFFFF" BorderThickness="1"/><Border x:Name="Cell02" BorderBrush="#667FFFFFFF" BorderThickness="1"/><Border x:Name="Cell03" BorderBrush="#667FFFFFFF" BorderThickness="1"/>
                        <Border x:Name="Cell10" BorderBrush="#667FFFFFFF" BorderThickness="1"/><Border x:Name="Cell11" BorderBrush="#667FFFFFFF" BorderThickness="1"/><Border x:Name="Cell12" BorderBrush="#667FFFFFFF" BorderThickness="1"/><Border x:Name="Cell13" BorderBrush="#667FFFFFFF" BorderThickness="1"/>
                        <Border x:Name="Cell20" BorderBrush="#667FFFFFFF" BorderThickness="1"/><Border x:Name="Cell21" BorderBrush="#667FFFFFFF" BorderThickness="1"/><Border x:Name="Cell22" BorderBrush="#667FFFFFFF" BorderThickness="1"/><Border x:Name="Cell23" BorderBrush="#667FFFFFFF" BorderThickness="1"/>
                        <Border x:Name="Cell30" BorderBrush="#667FFFFFFF" BorderThickness="1"/><Border x:Name="Cell31" BorderBrush="#667FFFFFFF" BorderThickness="1"/><Border x:Name="Cell32" BorderBrush="#667FFFFFFF" BorderThickness="1"/><Border x:Name="Cell33" BorderBrush="#667FFFFFFF" BorderThickness="1"/>
                    </UniformGrid>
                </Grid>
            </Viewbox>
        </Border>
        <StackPanel Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel Margin="8"><TextBlock Text="Empty" HorizontalAlignment="Center"/><Image x:Name="EmptyPreview" Width="72" Height="72"/></StackPanel>
                <StackPanel Margin="8"><TextBlock Text="Tier 1" HorizontalAlignment="Center"/><Image x:Name="Tier1Preview" Width="72" Height="72"/></StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Margin="4" Padding="12,7" Click="Recapture_Click">Chụp lại</Button>
                <Button Margin="4" Padding="12,7" Click="ReselectEmpty_Click">Chọn lại Empty</Button>
                <Button Margin="4" Padding="12,7" Click="ReselectTier1_Click">Chọn lại Tier 1</Button>
                <Button x:Name="SaveButton" Margin="4" Padding="12,7" Click="Save_Click" IsEnabled="False">Lưu hiệu chỉnh</Button>
                <Button Margin="4" Padding="12,7" Click="Cancel_Click">Hủy</Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
