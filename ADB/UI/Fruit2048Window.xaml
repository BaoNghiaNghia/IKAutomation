<Window x:Class="IK_Auto_ADB.UI.Fruit2048Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IKAutomation - Lễ Hội Trái Cây" Width="1180" Height="820"
        MinWidth="980" MinHeight="680" Background="#FFF4F7FB"
        FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterOwner"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="Primary" Color="#FF0F766E"/>
        <SolidColorBrush x:Key="Border" Color="#FFE2E8F0"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Primary}"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="4"/><Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="CompactCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/><Setter Property="Padding" Value="8,3"/>
            <Setter Property="BorderBrush" Value="#FFCBD5E1"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFFFF"/><Setter Property="Foreground" Value="#FF172033"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Lễ Hội Trái Cây" FontSize="24" FontWeight="Bold" Foreground="#FF172033"/>
                <TextBlock Text="Fruit 2048 · Chọn thiết bị, đọc bàn và tự động vuốt." Foreground="#FF64748B" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="BulkActionButton" DockPanel.Dock="Right" Style="{StaticResource Action}"
                    MinWidth="170" Padding="12,8" HorizontalAlignment="Right" Background="#FF475569" Click="BulkAction_Click">✓ Chọn tất cả khả dụng</Button>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="THIẾT BỊ" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                    <ListBox x:Name="DeviceList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                             SelectionChanged="DeviceList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#FFE2E8F0" Background="#FFFFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}"
                                                  Checked="DeviceSelectionChanged" Unchecked="DeviceSelectionChanged"
                                                  VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DeviceName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Background="{Binding StatusBadgeBackground}" BorderBrush="{Binding StatusBadgeBorder}"
                                                BorderThickness="1" CornerRadius="10" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusBadgeText}" Foreground="{Binding StatusBadgeForeground}" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="CHI TIẾT THIẾT BỊ ĐƯỢC CHỌN" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock x:Name="SelectedDeviceText" Grid.Row="1" Text="Chưa chọn thiết bị" FontSize="17" FontWeight="SemiBold" Margin="0,10"/>
                        <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel x:Name="BoardPanel" Grid.Column="0">
                            <TextBlock x:Name="BoardTitleText" Text="BÀN 4×4" FontWeight="SemiBold" Foreground="#FF475569" Margin="0,0,0,6"/>
                            <Border x:Name="BoardAutoSummaryPanel" Visibility="Collapsed" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="7" Background="#FFF8FAFC" Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="ĐANG CHẠY TỰ ĐỘNG" FontWeight="SemiBold" Foreground="#FF0F766E"/>
                                    <TextBlock x:Name="AutoBoardSummaryText" Foreground="#FF64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <ItemsControl x:Name="BoardItems" Width="360" Height="360" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="4" Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border BorderBrush="#FFCBD5E1" BorderThickness="1" Margin="3" CornerRadius="6" Background="#FFF8FAFC">
                                        <TextBlock Text="{Binding}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid x:Name="BoardStatsPanel" Margin="8,12,8,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Tile lớn nhất" Foreground="#FF64748B"/><TextBlock x:Name="HighestTileText" Text="0" FontWeight="Bold"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="Số lượt · Nước vừa đi" Foreground="#FF64748B"/><TextBlock x:Name="MoveSummaryText" Text="0 · —" FontWeight="Bold"/></StackPanel>
                            </Grid>
                        </StackPanel>
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="7" Background="#FFF8FAFC" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="NHẬN DIỆN" FontWeight="SemiBold" Foreground="#FF475569" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="LearningSummaryText" Text="Nhận diện: Learning · Đã học 0/0" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="HighestObservedText" Text="Tier cao nhất: 0 · Unknown: 0" Margin="0,3,0,0"/>
                                        <TextBlock x:Name="BootstrapText" Text="Bootstrap: Missing seeds" Margin="0,3,0,0" Foreground="#FF7C3AED"/>
                                        <TextBlock x:Name="BoardDiagnosticsText" Visibility="Collapsed" Text="Board: chưa quét" Margin="0,3,0,0" Foreground="#FF7C3AED"/>
                                        <TextBlock x:Name="LearningMessageText" Foreground="#FF0F766E" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="ProofStatusText" Foreground="#FF2563EB" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        <ItemsControl x:Name="LearningTierItems" Margin="0,5,0,0">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <Border BorderBrush="#FFCBD5E1" BorderThickness="1" CornerRadius="9" Padding="7,2" Margin="0,0,6,4"><TextBlock Text="{Binding}" FontSize="11"/></Border>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="ConfigurationPanel" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="144"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="THIẾT LẬP" FontWeight="SemiBold" Foreground="#FF475569" Margin="0,0,0,4"/>
                                            <TextBlock Text="Mục tiêu"/><ComboBox x:Name="TargetCombo" Style="{StaticResource CompactCombo}" SelectedIndex="4" Width="132" HorizontalAlignment="Left"><ComboBoxItem Content="128"/><ComboBoxItem Content="256"/><ComboBoxItem Content="512"/><ComboBoxItem Content="1024"/><ComboBoxItem Content="2048"/></ComboBox>
                                            <CheckBox x:Name="AutoRefreshCheck" Content="Tự làm mới khi hết nước đi" Margin="0,8,0,0" IsChecked="False"/>
                                            <StackPanel x:Name="AdvancedSettingsPanel" Visibility="Collapsed">
                                                <TextBlock Text="Dừng sau lượt không có mẫu mới" Margin="0,8,0,0"/><ComboBox x:Name="TeacherMoveLimitCombo" Style="{StaticResource CompactCombo}" SelectedIndex="0" Width="132" HorizontalAlignment="Left"><ComboBoxItem Content="Không giới hạn"/><ComboBoxItem Content="25"/><ComboBoxItem Content="50"/><ComboBoxItem Content="100"/><ComboBoxItem Content="250"/><ComboBoxItem Content="1000"/></ComboBox>
                                                <TextBlock Text="Xác thực" Margin="0,8,0,0"/><ComboBox x:Name="RunModeCombo" Style="{StaticResource CompactCombo}" SelectedIndex="0" Width="132" HorizontalAlignment="Left"><ComboBoxItem Content="Bình thường"/><ComboBoxItem Content="Burn-in"/><ComboBoxItem Content="Tự học ban đầu"/></ComboBox>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel x:Name="ManualControlsPanel" Grid.Column="1" HorizontalAlignment="Center">
                                            <TextBlock Text="ĐIỀU KHIỂN" FontWeight="SemiBold" Foreground="#FF475569" Margin="0,0,0,4"/>
                                            <Button x:Name="UpButton" Style="{StaticResource Action}" Content="↑" Width="40" Margin="2" Click="ManualUp_Click"/>
                                            <StackPanel Orientation="Horizontal"><Button x:Name="LeftButton" Style="{StaticResource Action}" Content="←" Width="40" Margin="2" Click="ManualLeft_Click"/><Button x:Name="DownButton" Style="{StaticResource Action}" Content="↓" Width="40" Margin="2" Click="ManualDown_Click"/><Button x:Name="RightButton" Style="{StaticResource Action}" Content="→" Width="40" Margin="2" Click="ManualRight_Click"/></StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <StackPanel Margin="0,10,0,0">
                                    <Grid x:Name="PrimaryActionsPanel">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Button x:Name="ScanButton" Grid.Column="0" Style="{StaticResource Action}" Background="#FF475569" Padding="8,7" Click="Scan_Click">Quét bàn</Button>
                                        <Button x:Name="StartButton" Grid.Column="1" Style="{StaticResource Action}" Padding="8,7" Click="StartOne_Click">▶ Chạy</Button>
                                        <Button x:Name="StopButton" Grid.Column="2" Style="{StaticResource Action}" Background="#FFDC2626" Padding="8,7" Click="StopOne_Click">■ Dừng</Button>
                                    </Grid>
                                    <Button x:Name="CalibrationButton" Style="{StaticResource Action}" Background="#FF2563EB" HorizontalAlignment="Stretch" Padding="8,7" Click="Calibration_Click">Hiệu chỉnh nhận diện</Button>
                                    <Expander x:Name="AdvancedToolsExpander" Header="Tùy chọn nâng cao" Margin="0,6,0,0" Expanded="AdvancedToolsExpander_Expanded" Collapsed="AdvancedToolsExpander_Collapsed">
                                        <WrapPanel><Button Style="{StaticResource Action}" Background="#FF64748B" Padding="8,7" Click="ExportLearning_Click">Xuất dữ liệu học</Button><Button Style="{StaticResource Action}" Background="#FF2563EB" Padding="8,7" Click="ExportBoardInspection_Click">Xuất kiểm tra Board</Button><Button x:Name="ExportLastFailureButton" Style="{StaticResource Action}" Background="#FF7C3AED" Padding="8,7" Click="ExportLastFailure_Click">Xuất lỗi gần nhất</Button><Button Style="{StaticResource Action}" Background="#FF0F766E" Padding="8,7" Click="SetTeacher_Click">Đặt làm thiết bị học</Button><Button Style="{StaticResource Action}" Background="#FFB45309" Padding="8,7" Click="ResetLearning_Click">Xóa dữ liệu học</Button><Button Style="{StaticResource Action}" Background="#FFB91C1C" Padding="8,7" Click="DeleteCalibratedSeeds_Click">Xóa mẫu hiệu chỉnh</Button></WrapPanel>
                                    </Expander>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
