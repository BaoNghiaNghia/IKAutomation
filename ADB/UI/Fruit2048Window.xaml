<Window x:Class="ADB_Tool_Automation_Post_FB.UI.Fruit2048Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IKAutomation - Lễ Hội Trái Cây" Width="1180" Height="820"
        MinWidth="980" MinHeight="680" Background="#FFF4F7FB"
        FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterOwner"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="Primary" Color="#FF0F766E"/>
        <SolidColorBrush x:Key="Border" Color="#FFE2E8F0"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Primary}"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="4"/><Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Lễ Hội Trái Cây" FontSize="24" FontWeight="Bold" Foreground="#FF172033"/>
                <TextBlock Text="Fruit 2048 · Chọn thiết bị, đọc bàn và tự động vuốt." Foreground="#FF64748B" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Action}" Background="#FF475569" Click="SelectAvailable_Click">Chọn tất cả khả dụng</Button>
                <Button Style="{StaticResource Action}" Click="StartSelected_Click">▶ Chạy đã chọn</Button>
                <Button Style="{StaticResource Action}" Background="#FFDC2626" Click="StopSelected_Click">■ Dừng đã chọn</Button>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="THIẾT BỊ" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                    <ListBox x:Name="DeviceList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                             SelectionChanged="DeviceList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="75"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding DisplayStatus}" Foreground="{Binding StatusBrush}" FontSize="12"/>
                                            <TextBlock Text="{Binding LastError}" Foreground="#FFDC2626" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding ConnectionText}" VerticalAlignment="Center" Foreground="#FF64748B"/>
                                        <TextBlock Grid.Column="3" Text="{Binding HighestTile}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding MoveCount}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{Binding LastMoveText}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="CHI TIẾT THIẾT BỊ ĐƯỢC CHỌN" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock x:Name="SelectedDeviceText" Grid.Row="1" Text="Chưa chọn thiết bị" FontSize="17" FontWeight="SemiBold" Margin="0,10"/>
                    <ItemsControl x:Name="BoardItems" Grid.Row="2" Width="360" Height="360" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="4" Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border BorderBrush="#FFCBD5E1" BorderThickness="1" Margin="3" CornerRadius="6" Background="#FFF8FAFC">
                                <TextBlock Text="{Binding}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Tile lớn nhất" Foreground="#FF64748B"/><TextBlock x:Name="HighestTileText" Text="0" FontWeight="Bold"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="Số lượt · Nước vừa đi" Foreground="#FF64748B"/><TextBlock x:Name="MoveSummaryText" Text="0 · —" FontWeight="Bold"/></StackPanel>
                    </Grid>
                    <Border Grid.Row="4" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="7"
                            Background="#FFF8FAFC" Padding="10" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock x:Name="LearningSummaryText" Text="Nhận diện: Learning · Đã học 0/0" FontWeight="SemiBold"/>
                            <TextBlock x:Name="BootstrapText" Text="Bootstrap: Missing seeds" Margin="0,3,0,0"/>
                            <TextBlock x:Name="HighestObservedText" Text="Tier cao nhất: 0 · Unknown: 0" Margin="0,3,0,0"/>
                            <TextBlock x:Name="LearningMessageText" Foreground="#FF0F766E" Margin="0,4,0,0"/>
                            <ItemsControl x:Name="LearningTierItems" Margin="0,5,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#FFCBD5E1" BorderThickness="1" CornerRadius="9"
                                                Padding="7,2" Margin="0,0,6,4">
                                            <TextBlock Text="{Binding}" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="5" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Mục tiêu"/>
                            <ComboBox x:Name="TargetCombo" SelectedIndex="4" Width="120" HorizontalAlignment="Left">
                                <ComboBoxItem Content="128"/><ComboBoxItem Content="256"/><ComboBoxItem Content="512"/><ComboBoxItem Content="1024"/><ComboBoxItem Content="2048"/>
                            </ComboBox>
                            <CheckBox x:Name="AutoRefreshCheck" Content="Tự làm mới khi hết nước đi" Margin="0,10,0,0" IsChecked="False"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <Button x:Name="UpButton" Style="{StaticResource Action}" Content="↑" Width="52" Click="ManualUp_Click"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="LeftButton" Style="{StaticResource Action}" Content="←" Width="52" Click="ManualLeft_Click"/>
                                <Button x:Name="DownButton" Style="{StaticResource Action}" Content="↓" Width="52" Click="ManualDown_Click"/>
                                <Button x:Name="RightButton" Style="{StaticResource Action}" Content="→" Width="52" Click="ManualRight_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="6" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="ScanButton" Style="{StaticResource Action}" Background="#FF475569" Click="Scan_Click">Scan Board</Button>
                            <Button x:Name="StartButton" Style="{StaticResource Action}" Click="StartOne_Click">Start</Button>
                            <Button x:Name="StopButton" Style="{StaticResource Action}" Background="#FFDC2626" Click="StopOne_Click">Stop</Button>
                        </StackPanel>
                        <Button x:Name="CalibrationButton" Style="{StaticResource Action}" Background="#FF2563EB"
                                HorizontalAlignment="Center" Click="Calibration_Click">Hiệu chỉnh nhận diện</Button>
                        <Expander Header="Nâng cao / gỡ lỗi" Margin="0,6,0,0" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Action}" Background="#FF64748B" Click="ExportLearning_Click">Xuất dữ liệu học</Button>
                                <Button Style="{StaticResource Action}" Background="#FF0F766E" Click="SetTeacher_Click">Đặt làm thiết bị học</Button>
                                <Button Style="{StaticResource Action}" Background="#FFB45309" Click="ResetLearning_Click">Xóa dữ liệu học</Button>
                                <Button Style="{StaticResource Action}" Background="#FFB91C1C" Click="DeleteCalibratedSeeds_Click">Xóa mẫu hiệu chỉnh</Button>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
